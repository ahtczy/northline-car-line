{
  "name": "northline-assembly",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pages": "tsc && VITE_BASE=/northline-car-line/ vite build",
